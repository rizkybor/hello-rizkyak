---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Leg from '../components/Leg.astro';
import Projects from '../components/Projects.astro';
import Downloads from '../components/Downloads.astro';
import { person, experience, skills, certificates, education } from '../data/profile';

const title = 'Rizky Ajie Kurniawan, Fullstack Developer dan Web GIS di Tangerang';
const description =
  'Portofolio Rizky Ajie Kurniawan, Fullstack Developer dengan pengalaman 4+ tahun di Laravel, Vue/Nuxt, React, dan PostgreSQL, serta pengembang OCCA untuk peta orienteering. Unduh CV dan portofolio PDF.';
---

<Base title={title} description={description}>
  <Header />
  <main id="main">
    <Hero />

    <Leg id="tentang" n={1} title="Tentang saya">
      <div class="about">
        <div class="about__text">
          <p>{person.summary}</p>
          <p>
            Saya terbiasa bekerja dari dokumen analisis dan ERD, lalu menurunkannya menjadi API, antarmuka, dan
            konfigurasi server. Di setiap proyek saya menjaga relasi data tetap rapi, hak akses berlapis, dan halaman
            publik ramah mesin pencari.
          </p>
          <p>
            Di luar pekerjaan klien, saya membangun OCCA: alat untuk menggambar peta orienteering dengan simbol standar
            IOF di iPad dan Mac. Proyek ini menyatukan dua hal yang saya sukai, rekayasa perangkat lunak dan peta.
          </p>
        </div>
        <dl class="facts">
          <div><dt>Peran saat ini</dt><dd>Fullstack Developer, PT Jendela Cakra Digital</dd></div>
          <div><dt>Spesialisasi</dt><dd>Sistem bisnis web, SaaS, dan Web GIS</dd></div>
          <div><dt>Pengalaman</dt><dd>{person.yearsExperience} tahun, sejak 2022</dd></div>
          <div><dt>Lokasi</dt><dd>{person.location}</dd></div>
          <div><dt>Bahasa</dt><dd>Indonesia, Inggris</dd></div>
          <div><dt>Pendidikan</dt><dd>S.Kom, Universitas Budi Luhur</dd></div>
        </dl>
      </div>
    </Leg>

    <Leg
      id="proyek"
      n={2}
      title="Proyek"
      intro="Empat proyek di bawah ini saya tulis lengkap. Detail teknis, arsitektur, dan sertifikat ada di portofolio PDF."
    >
      <Projects />
    </Leg>

    <Leg id="pengalaman" n={3} title="Pengalaman kerja">
      <ol class="timeline" reversed>
        {experience.map((e) => (
          <li>
            <time datetime={e.start}>{e.period}</time>
            <div>
              <h3>{e.role}</h3>
              <p class="org">{e.org}, {e.place}</p>
              <p>{e.note}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="edu">
        {education.map((ed) => (
          <p><strong>{ed.name}</strong>, {ed.detail} ({ed.period})</p>
        ))}
      </div>
    </Leg>

    <Leg id="keahlian" n={4} title="Keahlian dan sertifikat">
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
      <div class="certs">
        <h3>Sertifikat</h3>
        <ul>
          {certificates.map((c) => (
            <li><strong>{c.name}</strong><span>{c.issuer}, {c.date}</span></li>
          ))}
        </ul>
      </div>
    </Leg>

    <Leg
      id="unduh"
      finish
      class="leg--finish"
      title="Unduh dokumen"
      intro="Semua file berupa PDF yang ringan dan bisa dibaca sistem ATS."
    >
      <Downloads />
      <div class="contact">
        <h3>Butuh Fullstack Developer untuk tim kamu? Mari bicara.</h3>
        <ul>
          <li><span>Email</span><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><span>WhatsApp</span><a href={person.whatsapp} rel="noopener">{person.phoneDisplay}</a></li>
          <li><span>LinkedIn</span><a href={person.linkedin} rel="noopener me">rizky-ajie-kurniawan</a></li>
          <li><span>GitHub</span><a href={person.github} rel="noopener me">rizkybor</a></li>
        </ul>
      </div>
    </Leg>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>© {new Date().getFullYear()} {person.name}. Dibuat dengan Astro.</p>
      <ul class="legend" aria-label="Legenda warna halaman">
        <li><i style="background:#b35a1f"></i>Kontur</li>
        <li><i style="background:#f3b33d"></i>Lahan terbuka</li>
        <li><i style="background:#16709f"></i>Air dan tautan</li>
        <li><i style="background:#b0168f"></i>Course</li>
      </ul>
    </div>
  </footer>
</Base>
