---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProfile } from '../data';
import { getLang, t } from '../i18n/ui';
const lang = getLang(Astro.currentLocale);
const ui = t(lang);
const { projects } = getProfile(lang);

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg}', { eager: true });
const img = (name: string) => {
  const key = Object.keys(files).find((k) => k.includes(`/projects/${name}.`));
  return files[key!].default;
};
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const host = (u: string) => new URL(u).host.replace(/^www\./, '');
---
<div class="features">
  {featured.map((p, i) => (
    <article class:list={['feature', `feature--${p.slug}`]} id={`proyek-${p.slug}`}>
      <figure class="feature__media">
        <Image
          src={img(p.image)}
          alt={ui.a11y.view(p.name)}
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 92vw, 600px"
          format="webp"
          quality={72}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'auto' : undefined}
        />
      </figure>
      <div>
        <p class="feature__meta">{p.year}, {p.context}. {ui.projects.role}: {p.role}</p>
        <h3>{p.name}</h3>
        <p class="feature__tagline">{p.tagline}</p>
        <ul class="feature__points">{p.points.map((pt) => <li>{pt}</li>)}</ul>
        {p.facts && (
          <dl class="figures">
            {p.facts.map((f) => (
              <div><dt class="visually-hidden">{f.label}</dt><dd><strong>{f.value}</strong> <span>{f.label}</span></dd></div>
            ))}
          </dl>
        )}
        <ul class="stack" aria-label={ui.a11y.tech}>{p.stack.map((s) => <li>{s}</li>)}</ul>
        {p.url && <a class="ext" href={p.url} target="_blank" rel="noopener">{ui.projects.visit} {host(p.url)}</a>}
      </div>
    </article>
  ))}
</div>

<div class="more">
  <h3>{ui.projects.more}</h3>
  <table class="projtable">
    <caption class="visually-hidden">{ui.a11y.projectsCaption}</caption>
    <thead><tr>{ui.projects.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
    <tbody>
      {others.map((p) => (
        <tr id={`proyek-${p.slug}`}>
          <td>
            <span class="pname">{p.name}</span>
            <span class="pctx">{p.context}, {p.role}</span>
          </td>
          <td>{p.year}</td>
          <td>
            {p.tagline} {p.points[0]}
            <ul class="stack" aria-label={ui.a11y.tech}>{p.stack.map((s) => <li>{s}</li>)}</ul>
            {p.url && <a class="ext" href={p.url} target="_blank" rel="noopener">{host(p.url)}</a>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
