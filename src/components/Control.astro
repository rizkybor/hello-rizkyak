---
// Simbol overprint course IOF: start (segitiga), control (lingkaran bernomor), finish (lingkaran ganda).
interface Props { kind?: 'start' | 'control' | 'finish'; n?: number; label: string }
const { kind = 'control', n, label } = Astro.props;
---
<div class="control" role="img" aria-label={label}>
  {kind === 'control' && (
    <>
      <svg viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="22" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" /></svg>
      <span aria-hidden="true">{n}</span>
    </>
  )}
  {kind === 'finish' && (
    <svg viewBox="0 0 52 52" aria-hidden="true">
      <circle cx="26" cy="26" r="23" fill="var(--open-tint)" stroke="currentColor" stroke-width="2.5" />
      <circle cx="26" cy="26" r="15" fill="none" stroke="currentColor" stroke-width="2.5" />
    </svg>
  )}
</div>
