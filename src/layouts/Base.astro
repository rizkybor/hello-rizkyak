---
import '../styles/global.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import publicSansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import { getProfile } from '../data';
import { getLang, langMeta, t, LANGS } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const lang = getLang(Astro.currentLocale);
const ui = t(lang);
const { person, projects, skills, certificates, documents } = getProfile(lang);
const site = Astro.site!;
const canonical = new URL(langMeta[lang].path, site).href;
const ogImage = new URL('/og.png', site).href;
const personId = new URL('/#person', site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: site.href,
      name: `${person.name} — ${ui.meta.siteName}`,
      inLanguage: langMeta[lang].locale,
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': new URL('/#profile', site).href,
      url: canonical,
      name: title,
      description,
      inLanguage: langMeta[lang].locale,
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': personId },
      primaryImageOfPage: ogImage,
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: person.name,
      alternateName: person.shortName,
      jobTitle: person.role,
      description: person.summary,
      email: `mailto:${person.email}`,
      telephone: person.phoneIntl,
      url: site.href,
      image: ogImage,
      address: {
        '@type': 'PostalAddress',
        addressLocality: person.locality,
        addressRegion: person.region,
        addressCountry: person.country,
      },
      worksFor: { '@type': 'Organization', name: 'PT Jendela Cakra Digital', url: 'https://jcdigital.co.id' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Budi Luhur' },
      sameAs: [person.linkedin, person.github],
      knowsAbout: [...new Set(skills.flatMap((s) => s.items)), 'Web GIS', 'Orienteering mapping'],
      knowsLanguage: ['id', 'en'],
      hasCredential: certificates.map((c) => ({
        '@type': 'EducationalOccupationalCredential',
        name: c.name,
        recognizedBy: { '@type': 'Organization', name: c.issuer },
      })),
    },
    {
      '@type': 'ItemList',
      '@id': new URL('/#projects', site).href,
      name: ui.meta.projectsList,
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': p.slug === 'occa' ? 'SoftwareApplication' : 'CreativeWork',
          name: p.name,
          description: p.tagline,
          ...(p.slug === 'occa' ? { operatingSystem: 'iPadOS 17, macOS 14', applicationCategory: 'DesignApplication' } : {}),
          ...(p.url ? { url: p.url } : {}),
          dateCreated: p.year.slice(0, 4),
          creator: { '@id': personId },
          keywords: p.stack.join(', '),
        },
      })),
    },
    ...documents.map((d) => ({
      '@type': 'DigitalDocument',
      name: `${d.title} — ${person.name}`,
      encodingFormat: 'application/pdf',
      url: new URL(d.href, site).href,
      author: { '@id': personId },
    })),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(langMeta[l].path, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(langMeta.id.path, site).href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1a17" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Terapkan tema tersimpan sebelum render pertama supaya tidak berkedip.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={publicSansLatin} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:"Bricolage";font-style:normal;font-display:swap;font-weight:200 800;src:url(${bricolageLatin}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:"Public Sans";font-style:normal;font-display:swap;font-weight:100 900;src:url(${publicSansLatin}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`}
    />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langMeta[l].ogLocale} />)}
    <meta property="og:site_name" content={`${person.name} — ${ui.meta.siteName}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.meta.ogAlt(person.name, person.role, person.specialty)} />
    <meta property="profile:first_name" content="Rizky Ajie" />
    <meta property="profile:last_name" content="Kurniawan" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{ui.a11y.skip}</a>
    <slot />
  </body>
</html>
